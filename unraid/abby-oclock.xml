<?xml version="1.0"?>
<Container version="2">
  <Name>Abby O'Clock</Name>
  <Repository>ghcr.io/cerlendson/abby-oclock:latest</Repository>
  <Registry>https://github.com/cerlendson/TimeTeaching/pkgs/container/abby-oclock</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/cerlendson/TimeTeaching</Support>
  <Project>https://github.com/cerlendson/TimeTeaching</Project>
  <Overview>Abby O'Clock is a self-hosted clock learning game for elementary students. Progress is saved in each browser.</Overview>
  <Category>Education:Other</Category>
  <WebUI>http://[IP]:[PORT:4173]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/cerlendson/TimeTeaching/main/unraid/abby-oclock.xml</TemplateURL>
  <Icon/>
  <ExtraParams>--read-only --cap-drop=ALL --security-opt=no-new-privileges:true</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <Requires/>
  <Config Name="WebUI Port" Target="4173" Default="4173" Mode="tcp" Description="Web interface port." Type="Port" Display="always" Required="true" Mask="false">4173</Config>
</Container>
